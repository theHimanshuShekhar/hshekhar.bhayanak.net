        <li><a class="contact-link" href="https://github.com/theHimanshuShekhar" target="_blank" rel="noopener">→ github.com/theHimanshuShekhar</a></li>
        <li><a class="contact-link" href="https://www.linkedin.com/in/thehshekhar/" target="_blank" rel="noopener">→ linkedin.com/in/thehshekhar</a></li>
        <li><a class="contact-link" href="mailto:hshekhar.dev@gmail.com">→ hshekhar.dev@gmail.com</a></li>
      </ul>

      <!-- ls blog -->
      <div class="prompt mt-4">
        <span class="text-tn-prompt">hshekhar@bhayanak</span>
        <span class="text-tn-path"> ~</span>
        <span class="text-tn-dollar"> $</span>
        <span class="text-tn-cmd"> ls blog</span>
      </div>
      <h2 class="command-label">Blog</h2>
      <p class="text-tn-output"><a class="blog-link" href="/blog/">→ Somewhat organized chaos</a></p>

      <!-- Gag: bad commands cursor -->
      <div class="prompt mt-4">
        <span class="text-tn-prompt">hshekhar@bhayanak</span>
        <span class="text-tn-path"> ~</span>
        <span class="text-tn-dollar"> $</span>
        <span id="bad-cmd" class="text-tn-cmd"></span><span class="cursor"></span>
      </div>

    </main>

  </body>
</html>

<script>
  const BAD_CMDS = [
    'rm -rf /',
    'sudo rm -rf /',
    'pg drop prod',
    'dd if=/dev/random of=/dev/sda',
    ':(){ :|:& };:',
    'chmod -R 777 /',
    'DROP TABLE users;',
    'git push --force origin main',
    'cat /dev/urandom > /dev/sda',
    'mkfs.ext4 /dev/sda1',
    'sudo passwd root',
    'kill -9 1',
  ];

  const el = document.getElementById('bad-cmd');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let current = '';

  const sleep = ms => new Promise(r => setTimeout(r, ms));

  async function waitUntilVisible() {
    while (document.hidden) {
      await sleep(250);
    }
  }

  async function run() {
    if (!el) {
      return;
    }

    if (!el.isConnected || prefersReducedMotion.matches) {
      return;
    }

    while (true) {
      await waitUntilVisible();
      await sleep(1500 + Math.random() * 2000);

      const cmd = BAD_CMDS[Math.floor(Math.random() * BAD_CMDS.length)];

      for (const ch of cmd) {
        await waitUntilVisible();
        current += ch;
        el.textContent = ' ' + current;
        await sleep(70 + Math.random() * 80);
      }

      await sleep(600 + Math.random() * 800);

      while (current.length > 0) {
        await waitUntilVisible();
        current = current.slice(0, -1);
        el.textContent = current ? ' ' + current : '';
        await sleep(30 + Math.random() * 40);
      }
    }
  }

  run();
</script>

<style>
  .list {
    list-style-type: disc;
    padding-left: 1.5em;
  }

  .command-label {
    display: inline-block;
    font-size: inherit;
    font-weight: 500;
    padding: 0 0.5em;
    margin: 0;
    background-color: var(--color-tn-prompt);
    color: #1a1b26;
  }

  .output {
    width: 100%;
    max-width: 80ch;
  }

  .typeme {
    width: 30ch;
    white-space: nowrap;
    overflow: hidden;
    animation: typing 1.6s steps(25) forwards;
  }

  .typeme::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.1em;
    background-color: var(--color-tn-text);
    vertical-align: text-bottom;
    animation: blink-cursor 0.8s step-end infinite alternate;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    background-color: var(--color-tn-text);
    vertical-align: text-bottom;
    animation: blink-cursor 0.8s step-end infinite alternate;
  }

  @keyframes typing {
    0%   { width: 0; }
    100% { width: 30ch; }
  }

  @keyframes blink-cursor {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .typeme,
    .typeme::after,
    .cursor {
      animation: none;
    }

    .typeme {
      width: auto;
    }
  }
</style>
