      </div>

      <!-- cat signal.md -->
      <div class="prompt mt-4">
        <span class="text-tn-prompt">hshekhar@bhayanak</span>
        <span class="text-tn-path"> ~</span>
        <span class="text-tn-dollar"> $</span>
        <span class="text-tn-cmd"> cat signal.md</span>
      </div>
      <h2 class="command-label">Signal</h2>
      <ul class="text-tn-output list">
        <li>automation</li>
        <li>frontend: TanStack Start / TypeScript</li>
        <li>backend and API glue</li>
        <li>Linux, shells, deploys</li>
        <li>AI agents and coding tools</li>
        <li>gaming</li>
      </ul>

      <!-- cat now.md -->
      <div class="prompt mt-4">
        <span class="text-tn-prompt">hshekhar@bhayanak</span>
        <span class="text-tn-path"> ~</span>
        <span class="text-tn-dollar"> $</span>
        <span class="text-tn-cmd"> cat now.md</span>
      </div>
      <h2 class="command-label">Now</h2>
      <p class="text-tn-output">→ Grilling agent harnesses.</p>
      <ul class="text-tn-output list">
        <li>Pi Agent</li>
        <li>HermesAgent</li>
