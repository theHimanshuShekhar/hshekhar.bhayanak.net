---
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = posts[0];

const formatDate = (date: Date) => date.toISOString().slice(0, 10);

const postPath = (post: (typeof posts)[number]) => `/blog/${post.id.replace(/\.md$/, '')}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Engineering notes from Himanshu Shekhar on automation, frontend, Linux, agents, and better workflows." />
    <title>Blog | Himanshu Shekhar</title>
  </head>
  <body>
    <header class="blog-shell" aria-label="Blog command context">
      <p class="prompt-line">
        <span class="text-tn-prompt">hshekhar@bhayanak</span><span class="text-tn-path"> ~/blog</span><span class="text-tn-dollar"> $</span><span class="text-tn-cmd"> ls posts</span>
      </p>
      <h1 class="command-label">Somewhat organized chaos</h1>
      <p class="blog-intro text-tn-output">Mostly practical notes on automation, frontend, Linux, agents, and other tool-shaped rabbit holes.</p>
    </header>

    <main class="blog-workspace" aria-labelledby="blog-index-title">
      <section class="post-archive" aria-labelledby="blog-index-title">
        <div class="pane-command" aria-hidden="true">total {posts.length}</div>
        <h2 id="blog-index-title" class="sr-only">Blog posts</h2>

        {posts.length > 0 ? (
          <ol class="post-list">
            {posts.map((post) => (
              <li class="post-row">
                <a href={postPath(post)} class="post-row-link">
                  <span class="post-title-line">
                    <span class="post-title">{post.data.title}</span>
                    {post === latest && <span class="latest-marker">latest</span>}
                  </span>
                  <span class="post-meta">
                    {formatDate(post.data.pubDate)} · {post.data.tags.join(' / ')}
                  </span>
                  <span class="post-description">{post.data.description}</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-output text-tn-output">
            <p>No notes shipped yet.</p>
            <p>Try <a href="/">../home</a> if you came here for a conversation.</p>
          </div>
        )}
      </section>
    </main>

    <nav class="terminal-nav" aria-label="Terminal navigation">
      <a href="/">← home</a>
      <a href="mailto:hshekhar.dev@gmail.com">./contact.md</a>
    </nav>
  </body>
</html>

<style>
  .blog-shell {
    display: grid;
    gap: 0.55rem;
    max-width: 78ch;
  }

  .prompt-line {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .blog-intro {
    max-width: 68ch;
    margin: 0.2rem 0 0;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .blog-workspace {
    width: min(100%, 76ch);
    margin-top: clamp(1.8rem, 4vw, 3.5rem);
  }

  .post-archive {
    min-width: 0;
  }

  .pane-command,
  .post-meta,
  .post-description {
    color: var(--color-tn-output);
  }

  .pane-command {
    margin-bottom: 0.65rem;
  }

  .post-list {
    display: grid;
    gap: clamp(1rem, 2vw, 1.35rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .post-row-link {
    display: grid;
    gap: 0.22rem;
    min-height: 3.4rem;
    padding: 0.1rem 0;
    text-decoration: none;
  }

  .post-title-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
    align-items: baseline;
  }

  .post-row-link:hover .post-title,
  .post-row-link:focus-visible .post-title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .post-title {
    color: var(--color-tn-link);
    overflow-wrap: anywhere;
  }

  .latest-marker {
    color: var(--color-tn-dollar);
    font-size: 0.9em;
    white-space: nowrap;
  }

  .latest-marker::before {
    content: "[";
    color: var(--color-tn-output);
  }

  .latest-marker::after {
    content: "]";
    color: var(--color-tn-output);
  }

  .post-meta {
    line-height: 1.45;
  }

  .post-description {
    max-width: 62ch;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .terminal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .terminal-nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .empty-output {
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

</style>
