---
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = posts[0];

const formatDate = (date: Date) => date.toISOString().slice(0, 10);

const postPath = (post: (typeof posts)[number]) => `/blog/${post.id.replace(/\.md$/, '')}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Engineering notes from Himanshu Shekhar on automation, frontend, Linux, agents, and better workflows." />
    <title>Blog | Himanshu Shekhar</title>
  </head>
  <body>
    <header class="blog-shell" aria-label="Blog command context">
      <p class="prompt-line">
        <span class="text-tn-prompt">hshekhar@bhayanak</span><span class="text-tn-path"> ~/blog</span><span class="text-tn-dollar"> $</span><span class="text-tn-cmd"> ls posts</span>
      </p>
      <h1 class="command-label">Somewhat organized chaos</h1>
      <p class="blog-intro text-tn-output">Mostly practical notes on automation, frontend, Linux, agents, and other tool-shaped rabbit holes.</p>
    </header>

    <main class="blog-workspace" aria-labelledby="blog-index-title">
      <section class="post-pane post-pane-index" aria-labelledby="blog-index-title">
        <div class="pane-command" aria-hidden="true">total {posts.length}</div>
        <h2 id="blog-index-title" class="sr-only">Blog posts</h2>

        {posts.length > 0 ? (
          <ol class="post-list">
            {posts.map((post) => (
              <li class="post-row">
                <a href={postPath(post)} class="post-row-link">
                  <span class="post-date">{formatDate(post.data.pubDate)}</span>
                  <span class="post-tag">{post.data.tags[0] ?? 'note'}</span>
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-description">{post.data.description}</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-output text-tn-output">
            <p>No notes shipped yet.</p>
            <p>Try <a href="/">../home</a> if you came here for a conversation.</p>
          </div>
        )}
      </section>

      <aside class="post-pane post-pane-preview" aria-labelledby="latest-title">
        <p class="prompt-line preview-prompt">
          <span class="text-tn-prompt">hshekhar@bhayanak</span><span class="text-tn-path"> ~/blog</span><span class="text-tn-dollar"> $</span><span class="text-tn-cmd"> cat latest.md</span>
        </p>
        {latest ? (
          <article class="latest-note">
            <p class="post-meta">published {formatDate(latest.data.pubDate)} · {latest.data.tags.join(' / ')}</p>
            <h2 id="latest-title"><a href={postPath(latest)}>{latest.data.title}</a></h2>
            <p class="latest-description">{latest.data.description}</p>
            <a class="read-link" href={postPath(latest)}>open ./posts/{latest.id.replace(/\.md$/, '')}.md →</a>
          </article>
        ) : (
          <div class="empty-output text-tn-output">
            <p id="latest-title">cat: latest.md: No such file or directory</p>
          </div>
        )}
      </aside>
    </main>

    <nav class="terminal-nav" aria-label="Terminal navigation">
      <a href="/">← cd ..</a>
      <a href="mailto:hshekhar.dev@gmail.com">./contact.md</a>
    </nav>
  </body>
</html>

<style>
  .blog-shell {
    display: grid;
    gap: 0.55rem;
    max-width: 78ch;
  }

  .prompt-line {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .blog-intro {
    max-width: 68ch;
    margin: 0.2rem 0 0;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .blog-workspace {
    width: min(100%, 96rem);
    display: grid;
    gap: 1.2rem;
    margin-top: clamp(1.8rem, 4vw, 3.5rem);
  }

  .post-pane {
    min-width: 0;
  }

  .post-pane-preview {
    border-top: 1px solid color-mix(in srgb, var(--color-tn-output) 34%, transparent);
    padding-top: 1.2rem;
  }

  .pane-command,
  .post-meta,
  .post-date,
  .post-tag,
  .post-description {
    color: var(--color-tn-output);
  }

  .pane-command {
    margin-bottom: 0.65rem;
  }

  .post-list {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .post-row-link {
    display: grid;
    grid-template-columns: minmax(6.5rem, max-content) minmax(5rem, max-content) minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.15rem;
    align-items: baseline;
    min-height: 3.1rem;
    padding: 0.15rem 0;
    text-decoration: none;
  }

  .post-row-link:hover .post-title,
  .post-row-link:focus-visible .post-title,
  .latest-note a:hover,
  .latest-note a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .post-title {
    color: var(--color-tn-link);
    overflow-wrap: anywhere;
  }

  .post-description {
    grid-column: 3;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .preview-prompt {
    margin-bottom: 0.75rem;
  }

  .latest-note {
    display: grid;
    gap: 0.8rem;
    max-width: 68ch;
  }

  .latest-note h2 {
    margin: 0;
    font-size: clamp(1.35rem, 1.05rem + 1.2vw, 2.1rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .latest-note h2 a {
    color: var(--color-tn-text);
  }

  .post-meta,
  .latest-description {
    margin: 0;
    line-height: 1.55;
  }

  .latest-description {
    max-width: 58ch;
    color: var(--color-tn-output);
    text-wrap: pretty;
  }

  .read-link {
    width: fit-content;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .terminal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .terminal-nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .empty-output {
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .post-row-link {
      grid-template-columns: 1fr;
      gap: 0.16rem;
      min-height: 4rem;
    }

    .post-description {
      grid-column: auto;
    }
  }

  @media (min-width: 900px) {
    .blog-workspace {
      grid-template-columns: minmax(24rem, 0.72fr) minmax(28rem, 1fr);
      gap: clamp(1.4rem, 3vw, 2.8rem);
      align-items: start;
    }

    .post-pane-preview {
      border-top: 0;
      border-left: 1px solid color-mix(in srgb, var(--color-tn-output) 34%, transparent);
      padding-top: 0;
      padding-left: clamp(1.4rem, 3vw, 2.8rem);
      min-height: 22rem;
    }
  }
</style>
