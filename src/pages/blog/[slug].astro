---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const postSlug = (post: (typeof posts)[number]) => post.id.replace(/\.md$/, '');

  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      previous: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const published = dateFormatter.format(post.data.pubDate);
const slug = post.id.replace(/\.md$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={post.data.description} />
    <title>{post.data.title} | Himanshu Shekhar</title>
  </head>
  <body>
    <header class="article-command" aria-label="Article command context">
      <p class="prompt-line">
        <span class="text-tn-prompt">hshekhar@bhayanak</span><span class="text-tn-path"> ~/blog</span><span class="text-tn-dollar"> $</span><span class="text-tn-cmd"> less posts/{slug}.md</span>
      </p>
      <a class="back-link" href="/blog/">← cd ../blog</a>
    </header>

    <main class="article-buffer">
      <article>
        <header class="article-header">
          <p class="article-meta">published {published} · {post.data.tags.join(' / ')}</p>
          <h1># {post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>
        </header>

        <div class="article-content">
          <Content />
        </div>
      </article>
    </main>

    <nav class="post-nav" aria-label="Post navigation">
      {previous ? <a href={`/blog/${previous.id.replace(/\.md$/, '')}/`}>← older: {previous.data.title}</a> : <span aria-hidden="true"> </span>}
      {next ? <a href={`/blog/${next.id.replace(/\.md$/, '')}/`}>newer: {next.data.title} →</a> : <span aria-hidden="true"> </span>}
    </nav>
  </body>
</html>

<style>
  .article-command {
    display: grid;
    gap: 0.45rem;
    max-width: 78ch;
  }

  .prompt-line {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .back-link {
    width: fit-content;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .article-buffer {
    width: min(100%, 75ch);
    margin-top: clamp(1.8rem, 4vw, 3.5rem);
  }

  .article-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .article-meta,
  .article-description {
    margin: 0;
    color: var(--color-tn-output);
    line-height: 1.6;
    text-wrap: pretty;
  }

  h1 {
    margin: 0;
    color: var(--color-tn-text);
    font-size: clamp(1.55rem, 1.05rem + 2vw, 2.8rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .article-content {
    color: var(--color-tn-text);
    line-height: 1.68;
    letter-spacing: 0.005em;
  }

  .article-content :global(h2) {
    margin: clamp(2rem, 5vw, 3rem) 0 0.7rem;
    color: var(--color-tn-text);
    font-size: clamp(1.15rem, 1rem + 0.65vw, 1.55rem);
    line-height: 1.32;
    text-wrap: balance;
  }

  .article-content :global(h2::before) {
    content: '## ';
    color: var(--color-tn-prompt);
  }

  .article-content :global(p) {
    margin: 0 0 1.05rem;
    color: var(--color-tn-output);
    text-wrap: pretty;
  }

  .article-content :global(a) {
    color: var(--color-tn-link);
  }

  .article-content :global(code) {
    color: var(--color-tn-dollar);
    font-variant-ligatures: none;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    margin: clamp(1.2rem, 3vw, 1.8rem) 0;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-tn-output) 34%, transparent);
    color: var(--color-tn-text);
    line-height: 1.55;
  }

  .article-content :global(pre code) {
    color: var(--color-tn-text);
  }

  .post-nav {
    width: min(100%, 75ch);
    display: grid;
    gap: 0.65rem;
    margin-top: clamp(2.2rem, 5vw, 4rem);
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-tn-output) 34%, transparent);
  }

  .post-nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  @media (min-width: 760px) {
    .post-nav {
      grid-template-columns: 1fr 1fr;
    }

    .post-nav a:last-child {
      justify-self: end;
      text-align: right;
    }
  }
</style>
